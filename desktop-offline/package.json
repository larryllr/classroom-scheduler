{
  "name": "kuankuan-classroom-scheduler-offline",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "pack": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kuankuan.classroom.scheduler",
    "productName": "宽宽牌教室分配系统（离线版）",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "server.js",
      "db.js",
      "public/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
